---
import "@fontsource-variable/fraunces/opsz.css";
// latin-only subsets: the site is English + Spanish, both fully covered by
// the latin subset (á é í ó ú ü ñ ¿ ¡ included), so the remaining builds
// (latin-ext, cyrillic, greek, vietnamese) would only add dead @font-face
// declarations. Fraunces Variable has no per-subset CSS in Fontsource —
// opsz.css stays.
import "@fontsource/ibm-plex-sans/latin-400.css";
import "@fontsource/ibm-plex-sans/latin-500.css";
import "@fontsource/ibm-plex-sans/latin-600.css";
import "@fontsource/ibm-plex-mono/latin-400.css";
import "@fontsource/ibm-plex-mono/latin-500.css";
import "@/styles/global.css";
// ?url resolves to the final hashed asset path, so the preload can never
// drift from the file the @font-face actually loads.
import frauncesWoff2 from "@fontsource-variable/fraunces/files/fraunces-latin-opsz-normal.woff2?url";
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import { alternateHref, defaultLocale, localeHref, ogLocale, otherLang, type Lang } from "@/lib/i18n";
import { site, withBase } from "@/lib/site";
import { t } from "@/lib/strings";

interface Props {
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  publishedTime?: string;
  lang?: Lang;
  /** Same page in the other language. `null` means there is none (an
   * untranslated article) — no hreflang pair is emitted. Omitted = derive it
   * from the URL, which is right for every page that exists in both. */
  altHref?: string | null;
  /** Where the language chip goes. Defaults to `altHref`; a page with no
   * counterpart passes its section index so the chip is never a dead end. */
  switchHref?: string;
}

const {
  title,
  ogType = "website",
  publishedTime,
  lang = defaultLocale,
  altHref = alternateHref(Astro.url.pathname),
} = Astro.props;

const switchHref = Astro.props.switchHref ?? altHref ?? localeHref(otherLang(lang), "/");

const s = t(lang);
const description = Astro.props.description ?? s.meta.description;

const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — ${s.meta.role}`;
// Derived from site.url so a domain move only touches astro.config.mjs and
// src/lib/site.ts — no hardcoded origin here.
const origin = new URL(site.url).origin;
const canonical = `${origin}${Astro.url.pathname}`;
// Social preview card — regenerate with `node scripts/generate-og.mjs`.
const ogImage = `${origin}${withBase("/og.png")}`;

// hreflang only when the counterpart page actually exists, so search engines
// are never pointed at a 404. x-default goes to the English version.
const alternates =
  altHref === null
    ? []
    : [
        { hreflang: lang, href: canonical },
        { hreflang: otherLang(lang), href: `${origin}${altHref}` },
        { hreflang: "x-default", href: lang === defaultLocale ? canonical : `${origin}${altHref}` },
      ];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* GitHub Pages can't set HTTP headers; a meta CSP is the only option.
        'unsafe-inline' for scripts is required by the theme script below. */}
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {alternates.map((alt) => <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />)}
    {/* Fraunces paints the display h1 (the LCP text) — start fetching it
        before the CSS bundle finishes parsing. */}
    <link rel="preload" href={frauncesWoff2} as="font" type="font/woff2" crossorigin />
    <link rel="icon" href={withBase("/icon.svg")} type="image/svg+xml" />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content={ogLocale[lang]} />
    {
      altHref !== null && (
        <meta property="og:locale:alternate" content={ogLocale[otherLang(lang)]} />
      )
    }
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name} — ${s.meta.role}`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <script
      is:inline
      set:html={`(function(){try{var d=document.documentElement;d.classList.add("js");var t=localStorage.getItem("theme");if(t!=="light"&&t!=="dark"){t=window.matchMedia("(prefers-color-scheme: dark)").matches?"dark":"light"}d.dataset.theme=t}catch(e){}})()`}
    />
  </head>
  <body>
    <a href="#main" class="skip-link">{s.a11y.skipToContent}</a>
    <Header lang={lang} switchHref={switchHref} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Scroll reveal (fade + 12px slide). The hidden initial state only
      // applies when <html> has the "js" class, and a CSS safety animation
      // fades everything in after 3s regardless — this script can never
      // permanently hide content.
      const els = document.querySelectorAll(".reveal");
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        els.forEach((el) => el.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add("is-visible");
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: "0px 0px -32px 0px" }
        );
        els.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
