---
import BlogPostPage from "@/components/pages/BlogPostPage.astro";
import { entrySlug, getPosts } from "@/lib/content";

// Spanish posts only — content/blog/es/. Nothing is generated for posts that
// have not been translated yet.
export async function getStaticPaths() {
  const posts = await getPosts("es");
  return posts.map((post) => ({
    params: { slug: entrySlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
---

<BlogPostPage post={post} lang="es" />
