---
import ProjectPage from "@/components/pages/ProjectPage.astro";
import { entrySlug, getProjects } from "@/lib/content";

// Spanish case studies only — content/projects/es/.
export async function getStaticPaths() {
  const projects = await getProjects("es");
  return projects.map((project) => ({
    params: { slug: entrySlug(project.id) },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<ProjectPage project={project} lang="es" />
