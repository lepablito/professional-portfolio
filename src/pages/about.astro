---
import ExternalLink from "@/components/ExternalLink.astro";
import FactList from "@/components/FactList.astro";
import Base from "@/layouts/Base.astro";
import { certifications, community, education, experience, languages, skills } from "@/lib/about-data";
import { asset, site } from "@/lib/site";

const description =
  "AI Engineer with 4+ years building production-ready AI systems — GenAI, LLMs and autonomous agents on GCP, Azure and AWS. Community organizer at GDG Valladolid.";
---

<Base title="About" description={description}>
  <header class="article-header wrap">
    <p class="eyebrow rise">
      <span class="eyebrow-mark" aria-hidden="true">§</span>
      About
    </p>
    <h1 class="display rise rise-2">Prototype fast, ship for real.</h1>
  </header>

  <section class="section wrap" aria-label="Bio">
    <div class="reveal">
      <div class="about-grid">
        <div>
          <p class="lede">
            I'm an AI engineer with 4+ years building production-ready AI systems. My current focus is Generative AI —
            LLMs and autonomous agents — taken from prototype all the way to production. Most of my recent work runs on
            Google Cloud (Vertex AI), with hands-on experience across Azure and AWS as well.
          </p>
          <p class="lede">
            I've built machine-learning systems end to end: from designing the data pipelines and ETLs that feed them
            to the cloud microservice architectures they run on. Much of that happened inside Grupo Santander, where
            "production" means robust, scalable and secure by default.
          </p>
          <p class="lede">
            Underneath it all is a foundation in computer science, statistics and data science — paired with a genuine
            passion for developer relations: conference talks, community initiatives and live public demos. Teaching
            something is still my favorite way to learn it.
          </p>
          <div class="cta-actions">
            <a class="btn btn-primary" href={asset(site.cvPath)} download>Download CV (PDF)</a>
            <ExternalLink class="btn" href={site.linkedin}>LinkedIn ↗</ExternalLink>
          </div>
        </div>
        {/* TODO: replace with a real portrait at public/images/portrait.jpg
            and swap this frame for:
            <img src={asset("/images/portrait.jpg")} alt="Pablo Marcos Parra" /> */}
        <div class="portrait-frame" aria-hidden="true">
          <p class="mono">
            portrait goes here
            <br />
            public/images/portrait.jpg
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="experience-heading">
    <div class="reveal">
      <div class="section-head">
        <h2 id="experience-heading" class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true">§ 01</span>
          Experience
        </h2>
      </div>
      <ol class="timeline">
        {
          experience.map((job) => (
            <li class="timeline-item">
              <p class="mono">{job.period}</p>
              <h3 class="timeline-role">{job.role}</h3>
              <p class="timeline-org">{job.org}</p>
              <p class="timeline-desc">{job.description}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="community-heading">
    <div class="reveal">
      <div class="community-band">
        <h2 id="community-heading" class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true">§ 02</span>
          Community
        </h2>
        <p class="display community-title">Half of engineering is explaining it well.</p>
        <ul class="community-list">
          {
            community.map((entry) => (
              <li>
                <p class="mono">{entry.period}</p>
                <h3 class="community-role">{entry.role}</h3>
                <p class="mono community-detail">{entry.detail}</p>
                <p class="community-desc">{entry.description}</p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="skills-heading">
    <div class="reveal">
      <div class="section-head">
        <h2 id="skills-heading" class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true">§ 03</span>
          Skills
        </h2>
      </div>
      <div class="skills-grid">
        {
          skills.map((group) => (
            <div class="skills-group">
              <h3>{group.group}</h3>
              <ul class="tag-row">
                {group.items.map((item) => (
                  <li class="tag">{item}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section wrap" aria-labelledby="background-heading">
    <div class="reveal">
      <div class="section-head">
        <h2 id="background-heading" class="eyebrow">
          <span class="eyebrow-mark" aria-hidden="true">§ 04</span>
          Background
        </h2>
      </div>
      <div class="skills-grid">
        <div class="skills-group">
          <h3>Education</h3>
          <FactList facts={education} />
        </div>
        <div class="skills-group">
          <h3>Certifications</h3>
          <FactList facts={certifications} />
        </div>
        <div class="skills-group">
          <h3>Languages</h3>
          <FactList facts={languages} />
        </div>
      </div>
    </div>
  </section>
</Base>
